# ============================================================================
# SAGE backend — environment template
# Copy to backend/.env (git-ignored) and fill in real values:
#     cp backend/.env.example backend/.env
# ============================================================================

# Comma-separated list of origins allowed to call this API from a browser.
# Used by CORS middleware in app/main.py.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Member 2 — database ----------------------------------------------------
# PostgreSQL connection string. Read by database/connection.py.
# Defaults to a local SQLite file (backend/astra_guard.db) so the pipeline
# runs with zero external services; set this to use real PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/astra_guard

# runs with zero external services; set this to use real PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/astra_guard

# Phase 12.1: Authentication Layer (JWT Access Token & Secret)
SAGE_JWT_SECRET=replace_with_a_strong_random_secret
SAGE_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backwards-compatible alias used by older deployment configs.
# SAGE_JWT_EXPIRE_MINUTES=60

# Refresh token lifetime in days.
SAGE_REFRESH_EXPIRE_DAYS=7

# Comma-separated "username:password:role" users. Roles: admin, engineer, reviewer.
# NOTE: keep passwords simple; do not include commas.
SAGE_USERS=change-me-user:change-me-pass:admin

# Legacy single-admin fallback (used only when SAGE_USERS is not set):
# SAGE_AUTH_USERNAME=admin
# SAGE_AUTH_PASSWORD=change-this-password
# SAGE_AUTH_PASSWORD_HASH=$2b$12$...
