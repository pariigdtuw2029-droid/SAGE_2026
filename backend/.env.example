# ============================================================================
# SAGE backend — environment template
# Copy to backend/.env (git-ignored) and fill in real values:
#     cp backend/.env.example backend/.env
# ============================================================================

# Comma-separated list of origins allowed to call this API from a browser.
# Used by CORS middleware in app/main.py.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Member 2 — database ----------------------------------------------------
# PostgreSQL connection string. Read by database/connection.py.
# Defaults to a local SQLite file (backend/astra_guard.db) so the pipeline
# runs with zero external services; set this to use real PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/astra_guard

# --- Member 4 — JWT authentication (app/security.py, app/api/auth.py) -------
# REQUIRED for login to work. Generate a fresh secret (never commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SAGE_JWT_SECRET=change-me-generate-a-real-secret-before-deploying

# How long access tokens stay valid, in minutes (default 60). After this a
# request silently fails once and the console auto-refreshes (see below).
SAGE_JWT_EXPIRE_MINUTES=60

# How long refresh tokens stay valid, in days (default 7). This is the real
# "how often must I type the password again" window. Refresh rotates on use.
SAGE_REFRESH_EXPIRE_DAYS=7

# --- Users & roles -----------------------------------------------------------
# Comma-separated "username:password:role" triplets. Roles: admin (full
# access), engineer (can upload burn-in data), reviewer (read-only).
# NOTE: passwords must not contain commas; colons are fine in the password
# of the LAST segment only — keep it simple: no colons in passwords.
# SAGE_USERS=admin:sage2026:admin,priya:herPassword:engineer,rahul:hisPassword:reviewer
SAGE_USERS=change-me-user:change-me-pass:admin

# Legacy single-admin fallback (used only when SAGE_USERS is not set):
# SAGE_AUTH_USERNAME=admin
# SAGE_AUTH_PASSWORD=change-this-password
# SAGE_AUTH_PASSWORD_HASH=$2b$12$...   # bcrypt hash instead of plaintext
